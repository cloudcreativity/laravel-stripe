{
    "name": "cloudcreativity/laravel-stripe",
    "description": "Laravel integration for Stripe, including Stripe Connect.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Christopher Gammie",
            "email": "info@cloudcreativity.co.uk"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "psr/log": "^3.0",
        "stripe/stripe-php": "^16.2|^17.0"
    },
    "require-dev": {
        "laravel/cashier": "^15.6|^16.0",
        "laravel/legacy-factories": "^1.4",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.14|^10.0|^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "CloudCreativity\\LaravelStripe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CloudCreativity\\LaravelStripe\\Tests\\": "tests/lib"
        }
    },
    "scripts": {
        "all": [
            "@style",
            "@test"
        ],
        "style": "pint --test",
        "style:fix": "pint",
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "CloudCreativity\\LaravelStripe\\ServiceProvider"
            ],
            "aliases": {
                "Stripe": "CloudCreativity\\LaravelStripe\\Facades\\Stripe"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
